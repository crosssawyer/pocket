{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket",
  "version": "0.1.0",
  "identifier": "com.pocket.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pocket",
        "width": 900,
        "height": 650,
        "minWidth": 600,
        "minHeight": 450,
        "center": true,
        "transparent": true,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Secure password manager with a beautiful interface",
    "longDescription": "Pocket is a secure, cross-platform password manager featuring a modern liquid glass UI design. Store your passwords safely with AES-256 encryption.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "minimumSystemVersion": "10.13"
    }
  }
}
